# Public .env is a credential-free template; keep real values in ignored .env.* files.

# Server
PORT=4000
JWT_SECRET=
REFRESH_TOKEN_NAME=
NO_CRON=false

# Database and API host
DATABASE_URL=
HOST=

# Firebase
FIREBASE_CREDENTIAL_FILE=
FIREBASE_BUCKET=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# SendGrid
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# ECPay payment credentials
MERCHANTID=
HASHKEY=
HASHIV=

# ECPay logistics credentials
LOGISTICS_MERCHANTID=
LOGISTICS_HASH_KEY=
LOGISTICS_HASH_IV=
LOGISTICS_SENDER_CELL_PHONE=

# Transaction and delivery fees
TRANSACTION_FEE_RATE=0
HOME_DELIVERY_FEE=60
HOME_DELIVERY_REFRIG_FEE=160
OKMARTC2C_LOW_TMP_DELIVERY=160
ECPAY_FAMI_SHIPPING_FEE=60
ECPAY_UNIMART_SHIPPING_FEE=69
ECPAY_FAMIC2C_SHIPPING_FEE=69
ECPAY_UNIMARTC2C_SHIPPING_FEE=69
ECPAY_HILIFEC2C_SHIPPING_FEE=58
ECPAY_OKMARTC2C_SHIPPING_FEE=58

# Coin ledger and retention
COIN_LEDGER_ENABLED=true
AD_ARCHIVE_GRACE_HOURS=24
ADVERTISEMENT_ASSIGNMENT_COMPLETED_RETENTION_DAYS=365
ADVERTISEMENT_ASSIGNMENT_EXPIRED_RETENTION_DAYS=7
COIN_LEDGER_MAINTENANCE_CONCURRENCY=2
DATABASE_CLEANUP_BATCH_SIZE=5000
DEVICE_TOKEN_RETENTION_DAYS=60
IDEMPOTENCY_KEY_RETENTION_DAYS=3
COIN_LEDGER_JOB_RUN_RETENTION_DAYS=90

# Account wallet funding
ACCOUNT_WALLET_AD_FUNDING_ENABLED=true

# Password recovery: FE page URL; optional comma-separated additional exact URLs
ACCOUNT_PASSWORD_RESET_URL=
ACCOUNT_PASSWORD_RESET_ALLOWED_URLS=
